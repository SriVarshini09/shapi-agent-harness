# The live judge demo requires both values. Never place either in browser code.
MONGODB_URI=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
PORT=3007
# In-memory mode is only for local development and automated tests.
DEMO_STORAGE=atlas
# Optional Raindrop telemetry. Set the write key locally; never commit it.
RAINDROP_WRITE_KEY=
# Optional project slug; blank uses the account's default project.
RAINDROP_PROJECT_ID=
